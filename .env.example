# Porta em que o servidor vai rodar
PORT=3000

# URL pública do site (usada nos links de redirecionamento e webhook do pagamento)
# Em produção, use o domínio real, ex: https://dripimports.com.br
SITE_URL=http://localhost:3000

# Seu @ (InfiniteTag) da InfinitePay, SEM o símbolo $
# Exemplo: se o seu link é infinitepay.io/dripimports, coloque INFINITEPAY_HANDLE=dripimports
INFINITEPAY_HANDLE=drip-imports

# Senha de acesso ao painel administrativo (/admin)
# Troque por uma senha forte antes de publicar o site
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para assinar os cookies de sessão - gere uma string aleatória longa
SESSION_SECRET=troque-este-segredo-por-uma-string-aleatoria-longa
